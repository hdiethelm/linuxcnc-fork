# core HAL config file for simulation

# first load all the RT modules that will be needed
# kinematics
loadrt [KINS]KINEMATICS
# motion controller, get name and thread periods from INI file
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
# load 6 differentiators (for velocity and accel signals
loadrt ddt names=ddt_x,ddt_xv,ddt_y,ddt_yv,ddt_z,ddt_zv
# load additional blocks
loadrt hypot names=vel_xy,vel_xyz

loadrt soft_limits num_joints=3

# add motion controller functions to servo thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
# link the differentiator functions into the code
addf ddt_x servo-thread
addf ddt_xv servo-thread
addf ddt_y servo-thread
addf ddt_yv servo-thread
addf ddt_z servo-thread
addf ddt_zv servo-thread
addf vel_xy servo-thread
addf vel_xyz servo-thread
addf soft_limits.process servo-thread

#Create soft_limits connections

net XposSl joint.0.pos-cmd => soft_limits.0.pos-cmd-in
net YposSl joint.1.pos-cmd => soft_limits.1.pos-cmd-in
net ZposSl joint.2.pos-cmd => soft_limits.2.pos-cmd-in

net XvelSl joint.0.vel-cmd => soft_limits.0.vel-cmd-in
net YvelSl joint.1.vel-cmd => soft_limits.1.vel-cmd-in
net ZvelSl joint.2.vel-cmd => soft_limits.2.vel-cmd-in

net XaccSl joint.0.acc-cmd => soft_limits.0.acc-cmd-in
net YaccSl joint.1.acc-cmd => soft_limits.1.acc-cmd-in
net ZaccSl joint.2.acc-cmd => soft_limits.2.acc-cmd-in

net XhomedSl joint.0.homed => soft_limits.0.homed
net YhomedSl joint.1.homed => soft_limits.1.homed
net ZhomedSl joint.2.homed => soft_limits.2.homed

setp soft_limits.0.acc-max [JOINT_0]MAX_ACCELERATION
setp soft_limits.0.min-pos-limit [JOINT_0]MIN_LIMIT
setp soft_limits.0.max-pos-limit [JOINT_0]MAX_LIMIT

setp soft_limits.1.acc-max [JOINT_1]MAX_ACCELERATION
setp soft_limits.1.min-pos-limit [JOINT_1]MIN_LIMIT
setp soft_limits.1.max-pos-limit [JOINT_1]MAX_LIMIT

setp soft_limits.2.acc-max [JOINT_2]MAX_ACCELERATION
setp soft_limits.2.min-pos-limit [JOINT_2]MIN_LIMIT
setp soft_limits.2.max-pos-limit [JOINT_2]MAX_LIMIT

# create HAL signals for position commands from motion module
# loop position commands back to motion module feedback
net Xpos joint.0.motor-pos-cmd => joint.0.motor-pos-fb ddt_x.in
net Ypos joint.1.motor-pos-cmd => joint.1.motor-pos-fb ddt_y.in
net Zpos joint.2.motor-pos-cmd => joint.2.motor-pos-fb ddt_z.in

# send the position commands thru differentiators to
# generate velocity and accel signals
net Xvel ddt_x.out => ddt_xv.in vel_xy.in0
net Xacc <= ddt_xv.out
net Yvel ddt_y.out => ddt_yv.in vel_xy.in1
net Yacc <= ddt_yv.out
net Zvel ddt_z.out => ddt_zv.in vel_xyz.in0
net Zacc <= ddt_zv.out

# Cartesian 2- and 3-axis velocities
net XYvel vel_xy.out => vel_xyz.in1
net XYZvel <= vel_xyz.out

# estop loopback
net estop-loop iocontrol.0.user-enable-out iocontrol.0.emc-enable-in

# create signals for tool loading loopback
net tool-prep-loop iocontrol.0.tool-prepare iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change iocontrol.0.tool-changed

